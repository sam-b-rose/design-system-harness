{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@ds": ["./packages/ds/src/index.ts"]
    }
  },
  "include": ["ds.config.ts", "vite.config.ts", "packages", "cli", "lint", "scripts", "tests", "evals", "playground"],
  "exclude": ["node_modules", "dist", "evals/fixtures/bad", "evals/.tmp", "scripts/reset"]
}
