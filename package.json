{
  "name": "ds-agent-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "ds": "tsx cli/ds.ts",
    "docs:build": "tsx scripts/build-docs.ts",
    "docs:check": "tsx scripts/build-docs.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "tsx cli/ds.ts check",
    "test": "tsx --test tests/*.test.ts",
    "evals": "tsx evals/run.ts",
    "starter:reset": "tsx scripts/starter-reset.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7"
  }
}
