{
  "id": "login-form",
  "prompt": "Build a login form with an email field, a password field and a primary \"Sign in\" button. Export it as LoginForm.",
  "target": "playground/src/pages/LoginForm.tsx",
  "intent": [
    { "element": "form" },
    { "element": "TextField", "props": { "type": "email" }, "rule": "textfield/input-types" },
    { "element": "TextField", "props": { "type": "password" }, "rule": "textfield/input-types" },
    { "element": "Button", "props": { "type": "submit" }, "rule": "button/submit-type" },
    { "element": "Button", "props": { "variant": "primary" }, "count": 1, "rule": "button/one-primary" }
  ]
}
